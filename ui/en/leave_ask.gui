Panel.Panel1 {
    Position = ((&.w - w) / 2, (&.h - h) / 2);
    Size = (328, 80);

    Renderer {
        BackgroundColor = white;
        BorderColor = black;
        TextureBackground = "../holders/BARBTTON.png" Smooth;
    }

    Button.Abort {
        Position = ((((&.w / 2) - w) / 2) - 5, ((&.h - h) / 2) + 10);
        Size = (80, 21);
        TextSize = 13;

        Renderer {
            BackgroundColor = #F5F5F5;
            BackgroundColorDisabled = #E6E6E6;
            BackgroundColorDown = #EBEBEB;
            BackgroundColorHover = white;
            BorderColor = #3C3C3C;
            BorderColorDisabled = #7D7D7D;
            BorderColorDown = black;
            BorderColorFocused = #1E1EB4;
            BorderColorHover = black;
            Borders = (0, 0, 0, 0);
            TextColor = #3C3C3C;
            TextColorDisabled = #7D7D7D;
            TextColorDown = black;
            TextColorHover = black;
            Texture = "../buttons/BUT8_UP.png" Smooth;
            TextureDisabled = "../buttons/BUT8_UP.png" Smooth;
            TextureDown = "../buttons/BUT8_DN.png" Smooth;
            TextureDownFocused = "../buttons/BUT8_DN.png" Smooth;
            TextureDownHover = "../buttons/BUT8_DN.png" Smooth;
            TextureFocused = "../buttons/BUT8_UP.png" Smooth;
            TextureHover = "../buttons/BUT8_UP.png" Smooth;
        }
    }

    Button.Cancel {
        Position = (((((&.w * 3) / 2) - w) / 2) + 5, ((&.h - h) / 2) + 10);
        Size = (80, 21);
        TextSize = 13;

        Renderer {
            BackgroundColor = #F5F5F5;
            BackgroundColorDisabled = #E6E6E6;
            BackgroundColorDown = #EBEBEB;
            BackgroundColorHover = white;
            BorderColor = #3C3C3C;
            BorderColorDisabled = #7D7D7D;
            BorderColorDown = black;
            BorderColorFocused = #1E1EB4;
            BorderColorHover = black;
            Borders = (0, 0, 0, 0);
            TextColor = #3C3C3C;
            TextColorDisabled = #7D7D7D;
            TextColorDown = black;
            TextColorHover = black;
            Texture = "../buttons/BUT8_UP.png" Smooth;
            TextureDisabled = "../buttons/BUT8_UP.png" Smooth;
            TextureDown = "../buttons/BUT8_DN.png" Smooth;
            TextureDownFocused = "../buttons/BUT8_DN.png" Smooth;
            TextureDownHover = "../buttons/BUT8_DN.png" Smooth;
            TextureFocused = "../buttons/BUT8_UP.png" Smooth;
            TextureHover = "../buttons/BUT8_UP.png" Smooth;
        }
    }

    Button.Surrender {
        Position = ((&.w - w) / 2, ((&.h - h) / 2) + 10);
        Size = (80, 21);
        TextSize = 13;

        Renderer {
            BackgroundColor = #F5F5F5;
            BackgroundColorDisabled = #E6E6E6;
            BackgroundColorDown = #EBEBEB;
            BackgroundColorHover = white;
            BorderColor = #3C3C3C;
            BorderColorDisabled = #7D7D7D;
            BorderColorDown = black;
            BorderColorFocused = #1E1EB4;
            BorderColorHover = black;
            Borders = (0, 0, 0, 0);
            TextColor = #3C3C3C;
            TextColorDisabled = #7D7D7D;
            TextColorDown = black;
            TextColorHover = black;
            Texture = "../buttons/BUT8_UP.png" Smooth;
            TextureDisabled = "../buttons/BUT8_UP.png" Smooth;
            TextureDown = "../buttons/BUT8_DN.png" Smooth;
            TextureDownFocused = "../buttons/BUT8_DN.png" Smooth;
            TextureDownHover = "../buttons/BUT8_DN.png" Smooth;
            TextureFocused = "../buttons/BUT8_UP.png" Smooth;
            TextureHover = "../buttons/BUT8_UP.png" Smooth;
        }
    }

    Picture.Picture1 {
        IgnoreMouseEvents = true;
        Position = (((Abort.w - w) / 2) + Abort.x, ((Abort.h - h) / 2) + Abort.y);
        Size = (31, 13);

        Renderer {
            Texture = "abort2.png" NoSmooth;
            TransparentTexture = false;
        }
    }

    Picture.Picture2 {
        IgnoreMouseEvents = true;
        Position = (((Cancel.w - w) / 2) + Cancel.x, ((Cancel.h - h) / 2) + Cancel.y);
        Size = (33, 13);

        Renderer {
            Texture = "cancel.png" NoSmooth;
            TransparentTexture = false;
        }
    }

    Picture.Picture3 {
        IgnoreMouseEvents = true;
        Position = (((Surrender.w - w) / 2) + Surrender.x, ((Surrender.h - h) / 2) + Surrender.y);
        Size = (55, 13);

        Renderer {
            Texture = "surrender.png" NoSmooth;
            TransparentTexture = false;
        }
    }

    Picture.Picture4 {
        IgnoreMouseEvents = true;
        Position = (((Surrender.w - w) / 2) + Surrender.x, (((Surrender.h - h) / 2) + Surrender.y) - 20);
        Size = (85, 13);

        Renderer {
            Texture = "certain.png" NoSmooth;
            TransparentTexture = false;
        }
    }
